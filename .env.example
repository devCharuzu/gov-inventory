# Non-secret configuration template.
# Copy the backend-specific template to backend/.env for local development:
#   cp backend/.env.example backend/.env
# Never commit backend/.env or paste its values into chat.

DATABASE_URL=postgresql+psycopg://postgres.<PROJECT_REF>:<URL_ENCODED_DATABASE_PASSWORD>@aws-0-ap-southeast-1.pooler.supabase.com:6543/postgres?sslmode=require
SECRET_KEY=<generate-a-long-random-secret>
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=480
APP_NAME=Philfida Inventory System
ENVIRONMENT=production
AUTO_CREATE_SCHEMA=false
CORS_ORIGINS=https://<VERCEL_DOMAIN>
INITIAL_ADMIN_USERNAME=admin
INITIAL_ADMIN_FULL_NAME=System Administrator
INITIAL_ADMIN_EMAIL=admin@<your-domain>
INITIAL_ADMIN_PASSWORD=<set-a-strong-one-time-password>

# Server-only Supabase settings. These must be added to Vercel as encrypted
# environment variables, not committed to this repository.
SUPABASE_URL=https://<PROJECT_REF>.supabase.co
SUPABASE_SECRET_KEY=<server-only-secret-key>
