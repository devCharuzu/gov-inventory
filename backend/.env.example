# Local FastAPI configuration.
# This file is safe to commit because it contains placeholders only.
# Copy it to backend/.env and fill in the values locally:
#   cp backend/.env.example backend/.env

# Supabase Dashboard → Connect → Transaction pooler.
# URL-encode special characters in the database password.
DATABASE_URL=postgresql+psycopg://postgres.<PROJECT_REF>:<URL_ENCODED_DATABASE_PASSWORD>@aws-0-ap-southeast-1.pooler.supabase.com:6543/postgres?sslmode=require

# Generate locally; never reuse or commit this value.
# Example command:
#   openssl rand -base64 48
SECRET_KEY=<generate-a-long-random-secret>
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=480
APP_NAME=Philfida Inventory System
ENVIRONMENT=development
AUTO_CREATE_SCHEMA=true
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
INITIAL_ADMIN_USERNAME=admin
INITIAL_ADMIN_FULL_NAME=System Administrator
INITIAL_ADMIN_EMAIL=admin@gov.local
INITIAL_ADMIN_PASSWORD=

# Optional server-side Supabase settings for Storage/report persistence.
# Never rename the secret key with a VITE_ prefix and never place it in the frontend.
SUPABASE_URL=https://<PROJECT_REF>.supabase.co
SUPABASE_SECRET_KEY=<server-only-secret-key>
